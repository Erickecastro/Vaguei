<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vaguei.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F6F7FB" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F0F2F7" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1D26" />
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#626879" />
          <SolidColorBrush x:Key="OutlineBrush" Color="#DDE1EA" />
          <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#252936" />
          <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentBrush" Color="#5856D6" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#4745C4" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#ECEBFF" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A70" />
          <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#E1E4EB" />
          <SolidColorBrush x:Key="WindowControlPressedBrush" Color="#D4D8E1" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#121212" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1B1B" />
          <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#252525" />
          <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B5B5B5" />
          <SolidColorBrush x:Key="OutlineBrush" Color="#383838" />
          <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#EBEBEB" />
          <SolidColorBrush x:Key="InverseTextBrush" Color="#171717" />
          <SolidColorBrush x:Key="AccentBrush" Color="#E5E5E5" />
          <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#303030" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#161616" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#CCCCCC" />
          <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#424242" />
          <SolidColorBrush x:Key="WindowControlPressedBrush" Color="#505050" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
  </Application.Styles>
</Application>
