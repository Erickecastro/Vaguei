<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Vaguei.Desktop.ViewModels;assembly=Vaguei.Maui"
             x:Class="Vaguei.Maui.MainPage"
             x:DataType="vm:MainViewModel"
             NavigationPage.HasNavigationBar="False">
  <Grid Padding="18,16" RowDefinitions="*"
        BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#121212}">
    <Grid IsVisible="{Binding ShowSearchChrome}" RowDefinitions="*,Auto,*">
      <VerticalStackLayout Grid.Row="1" Spacing="14">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <Image WidthRequest="54" HeightRequest="54"
                 Source="{AppThemeBinding Light=logo_light_56.png, Dark=logo_dark_56.png}" />
          <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
            <Label Text="Vaguei" FontSize="24" FontAttributes="Bold" />
            <Label Text="Sua próxima oportunidade" FontSize="12"
                   TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
          </VerticalStackLayout>
          <Button Grid.Column="2" Text="ⓘ" WidthRequest="52" HeightRequest="52"
                  CornerRadius="26" Padding="0" FontSize="27"
                  SemanticProperties.Description="Sobre o Vaguei" Clicked="OnAboutClicked" />
          <Button Grid.Column="3" Text="◐" WidthRequest="52" HeightRequest="52"
                  CornerRadius="26" Padding="0" FontSize="30"
                  SemanticProperties.Description="Alternar tema" Clicked="OnThemeClicked" />
        </Grid>

        <Border Padding="16" Stroke="{AppThemeBinding Light=#DDE1EA, Dark=#383838}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1B1B}"
                StrokeShape="RoundRectangle 18">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
              <Label Text="Currículo" FontSize="17" FontAttributes="Bold" />
              <Label Text="{Binding SelectedFileName}" FontSize="12" LineBreakMode="TailTruncation"
                     TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
              <Label Text="Acesso somente ao documento escolhido" FontSize="10"
                     TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Anexar" WidthRequest="100" Clicked="OnChooseResumeClicked"
                    BackgroundColor="{AppThemeBinding Light=#5856D6, Dark=#F0F0F0}"
                    TextColor="{AppThemeBinding Light=White, Dark=#151515}" />
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                  IsVisible="{Binding HasProfile}" ColumnDefinitions="*,Auto">
              <VerticalStackLayout Spacing="1">
                <Label Text="{Binding CandidateName}" FontAttributes="Bold" />
                <Label Text="{Binding ProfessionalTitle}" FontSize="12"
                       TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
                <Label Text="{Binding ProfileSummary}" MaxLines="2" LineBreakMode="TailTruncation" FontSize="11"
                       TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
              </VerticalStackLayout>
              <Button Grid.Column="1" Text="×" WidthRequest="44" HeightRequest="44" Padding="0"
                      Command="{Binding RemoveResumeCommand}" SemanticProperties.Description="Remover currículo" />
            </Grid>
          </Grid>
        </Border>

        <Border Padding="12,3" Stroke="{AppThemeBinding Light=#DDE1EA, Dark=#383838}"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1B1B}"
                StrokeShape="RoundRectangle 14">
          <Entry Text="{Binding DesiredRole}" Placeholder="Cargo, tecnologia ou empresa"
                 ReturnType="Search" />
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <Button x:Name="SearchButton" Text="Pesquisar" Command="{Binding RefreshJobsCommand}"
                  BackgroundColor="{AppThemeBinding Light=#5856D6, Dark=#F0F0F0}"
                  TextColor="{AppThemeBinding Light=White, Dark=#151515}" FontAttributes="Bold" />
          <Button Grid.Column="1" Text="Filtros" Clicked="OnFiltersClicked" />
        </Grid>
      </VerticalStackLayout>
    </Grid>

    <Grid IsVisible="{Binding ShowSearchProgress}" VerticalOptions="Center" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
      <Label Text="Buscando oportunidades" HorizontalTextAlignment="Center"
             FontSize="22" FontAttributes="Bold" />
      <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}"
                         Color="{AppThemeBinding Light=#5856D6, Dark=#F2F2F2}"
                         WidthRequest="42" HeightRequest="42" />
      <Label Grid.Row="2" Text="Consultando fontes disponíveis…" HorizontalTextAlignment="Center"
             FontSize="13" TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
    </Grid>

    <Grid IsVisible="{Binding ShowResultsContent}" RowDefinitions="Auto,10,*">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Button Text="‹" WidthRequest="44" HeightRequest="44" Padding="0" FontSize="25"
                Command="{Binding ReturnToSearchCommand}" SemanticProperties.Description="Voltar para a busca" />
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
          <Label Text="Oportunidades" FontSize="21" FontAttributes="Bold" />
          <Label Text="{Binding StatusMessage}" MaxLines="1" LineBreakMode="TailTruncation" FontSize="11"
                 TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
        </VerticalStackLayout>
      </Grid>

      <CollectionView Grid.Row="2" x:Name="JobsCollection" ItemsSource="{Binding Jobs}"
                      SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
          <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
          </CollectionView.ItemsLayout>
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:JobResultItemViewModel">
              <Border Padding="13,11" MinimumHeightRequest="174"
                      Stroke="{AppThemeBinding Light=#DDE1EA, Dark=#383838}"
                      BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1B1B}"
                      StrokeShape="RoundRectangle 16">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="3">
                  <VerticalStackLayout Grid.ColumnSpan="2" Spacing="1">
                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold"
                           MaxLines="2" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Company}" FontSize="12" FontAttributes="Bold" />
                    <Label Text="{Binding Location}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
                  </VerticalStackLayout>
                  <Label Grid.Row="1" Margin="0,4,0,0" IsVisible="{Binding ShowCompatibility}"
                         Text="{Binding Score, StringFormat='Compatibilidade {0}'}" FontSize="11" FontAttributes="Bold" />
                  <Label Grid.Row="2" FontSize="10" Text="{Binding Source}"
                         TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
                  <Label Grid.Row="3" FontSize="10" Text="{Binding Published}"
                         TextColor="{AppThemeBinding Light=#626879, Dark=#B5B5B5}" />
                  <HorizontalStackLayout Grid.Row="1" Grid.RowSpan="3" Grid.Column="1"
                                         VerticalOptions="End" Spacing="7">
                    <Button Text="{Binding FavoriteSymbol}" WidthRequest="44" HeightRequest="44" Padding="0"
                            FontSize="18" Command="{Binding ToggleFavoriteCommand}" />
                    <Button Text="Abrir ›" WidthRequest="86" HeightRequest="44" Padding="8,0"
                            CommandParameter="{Binding Url}" Clicked="OnOpenJobClicked" />
                  </HorizontalStackLayout>
                </Grid>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
      </CollectionView>
    </Grid>

    <Button IsVisible="{Binding ShowResultsContent}" HorizontalOptions="Start" VerticalOptions="End"
            Margin="4,0,0,6" Text="↑" WidthRequest="46" HeightRequest="46" Padding="0"
            FontSize="21" CornerRadius="23" Clicked="OnScrollToTopClicked"
            SemanticProperties.Description="Voltar ao topo" />

    <Border x:Name="FiltersSheet" IsVisible="False" VerticalOptions="End" Padding="18"
            Stroke="{AppThemeBinding Light=#DDE1EA, Dark=#383838}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1B1B1B}"
            StrokeShape="RoundRectangle 24">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*"
            ColumnSpacing="10" RowSpacing="10">
        <Label Text="Filtros" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
        <Button Grid.Column="1" HorizontalOptions="End" Text="×" WidthRequest="44" HeightRequest="44"
                Padding="0" Clicked="OnFiltersCloseClicked" />
        <Button Grid.Row="1" Text="{Binding SelectedSearchScopeLabel}" Clicked="OnSearchScopeFilterClicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPublicationWindowLabel}" Clicked="OnPublicationFilterClicked" />
        <Entry Grid.Row="2" Placeholder="Cidade ou estado" Text="{Binding LocationFilter}" />
        <Button Grid.Row="2" Grid.Column="1" Text="{Binding SelectedWorkModelLabel}" Clicked="OnWorkModelFilterClicked" />
        <Button Grid.Row="3" Text="{Binding SelectedEmploymentTypeLabel}" Clicked="OnEmploymentFilterClicked" />
        <Button Grid.Row="3" Grid.Column="1" Text="{Binding SelectedSeniorityLabel}" Clicked="OnSeniorityFilterClicked" />
        <Button Grid.Row="4" Grid.ColumnSpan="2" Text="Limpar filtros" Command="{Binding ClearAdvancedFiltersCommand}" />
      </Grid>
    </Border>

    <Grid x:Name="FilterOptionsOverlay" IsVisible="False"
          BackgroundColor="{AppThemeBinding Light=#66000000, Dark=#99000000}">
      <Border Margin="18" Padding="18" VerticalOptions="Center"
              MaximumHeightRequest="620"
              BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1B1B1B}"
              Stroke="{AppThemeBinding Light=#DDE1EA, Dark=#3A3A3A}"
              StrokeShape="RoundRectangle 24">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Label x:Name="FilterOptionsTitle" FontSize="21" FontAttributes="Bold" />
          <CollectionView Grid.Row="1" x:Name="FilterOptionsList" SelectionMode="None">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Button Text="{Binding DisplayText}" CommandParameter="{Binding Index}"
                        Clicked="OnFilterOptionClicked" HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start" Margin="0,2" />
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
          <Button Grid.Row="2" Text="Cancelar" Clicked="OnFilterOptionsCloseClicked" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
